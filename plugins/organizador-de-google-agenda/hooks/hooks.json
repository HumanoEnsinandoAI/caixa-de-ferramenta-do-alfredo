{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-notice.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "RemoteTrigger|mcp__scheduled-tasks__create_scheduled_task|mcp__scheduled-tasks__update_scheduled_task|mcp__scheduled-tasks__delete_scheduled_task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/routines-changed.sh\""
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
